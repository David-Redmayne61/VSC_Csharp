@model IEnumerable<FirstProject.Models.CustomerContact>

@{
    ViewData["Title"] = "Customer Calls";
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Customer Calls</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-telephone-fill text-primary me-2"></i>
                        Customer Calls
                    </h2>
                    <p class="text-muted mb-0">Manage customer call records and contact history</p>
                </div>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-house-door me-2"></i>
                        Back to Dashboard
                    </a>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>
                        Record New Call
                    </a>
                </div>
            </div>

            <!-- Success Message -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <i class="bi bi-telephone display-4 text-primary mb-2"></i>
                            <h4 class="card-title">@Model.Count()</h4>
                            <p class="card-text text-muted">Total Contacts</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <i class="bi bi-calendar-today display-4 text-info mb-2"></i>
                            <h4 class="card-title">@Model.Count(c => c.ContactDate.Date == DateTime.Today)</h4>
                            <p class="card-text text-muted">Today's Contacts</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <i class="bi bi-calendar-week display-4 text-warning mb-2"></i>
                            <h4 class="card-title">@Model.Count(c => c.ContactDate >= DateTime.Today.AddDays(-7))</h4>
                            <p class="card-text text-muted">This Week</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <i class="bi bi-people display-4 text-success mb-2"></i>
                            <h4 class="card-title">@Model.Select(c => c.PersonId).Distinct().Count()</h4>
                            <p class="card-text text-muted">Unique Customers</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contacts Table -->
            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Call Number</th>
                                        <th>Customer</th>
                                        <th>Initial Call Date</th>
                                        <th>Status</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Created By</th>
                                        <th>Last Modified</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                                    <strong class="text-primary">@item.CallNumber</strong>
                                                </a>
                                            </td>
                                            <td>
                                                <i class="bi bi-person-circle me-1"></i>
                                                @item.Person?.FamilyName, @item.Person?.Forename
                                            </td>
                                            <td>
                                                <i class="bi bi-calendar me-1"></i>
                                                @item.ContactDate.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td>
                                                @item.Status
                                            </td>
                                            <td>
                                                <i class="bi bi-envelope me-1"></i>
                                                <a href="mailto:@item.CustomerEmail" class="text-decoration-none">@item.CustomerEmail</a>
                                            </td>
                                            <td>
                                                <i class="bi bi-telephone me-1"></i>
                                                <a href="tel:@item.CustomerPhone" class="text-decoration-none">@item.CustomerPhone</a>
                                            </td>
                                            <td>
                                                <i class="bi bi-person-badge me-1"></i>
                                                @(item.CreatedBy ?? "Unknown")
                                            </td>
                                            <td>
                                                @if (item.LastModified.HasValue)
                                                {
                                                    <small class="text-muted">
                                                        <i class="bi bi-clock me-1"></i>
                                                        @item.LastModified.Value.ToString("dd/MM/yy HH:mm")
                                                        <br>
                                                        <span class="fw-bold">@(item.ModifiedBy ?? "Unknown")</span>
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    @if (item.Status == ContactStatus.Closed)
                                                    {
                                                        <a onclick="return confirmEditClosed('@Url.Action("Edit", new { id = item.Id })')" class="btn btn-sm btn-outline-warning" title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    }
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-telephone-x display-1 text-muted mb-3"></i>
                            <h4 class="text-muted">No Customer Calls Found</h4>
                            <p class="text-muted">Get started by recording your first customer call.</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>
                                Record First Call
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function confirmEditClosed(editUrl) {
    if (confirm("This call is marked as CLOSED. Are you sure you want to edit it?")) {
        window.location.href = editUrl;
        return true;
    }
    return false;
}
</script>
