@model FirstProject.Models.CustomerContact

@{
    ViewData["Title"] = "Delete Contact";
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-controller="Contact" asp-action="Index">Customer Calls</a></li>
            <li class="breadcrumb-item active" aria-current="page">Delete @Model.CallNumber</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header Section -->
            <div class="text-center mb-4">
                <h2 class="mb-1 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Delete Customer Contact
                </h2>
                <p class="text-muted">Are you sure you want to delete this contact record?</p>
            </div>

            <!-- Warning Alert -->
            <div class="alert alert-danger" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Warning: Permanent Deletion
                </h5>
                <p class="mb-0">This action cannot be undone. The contact record will be permanently removed from the database.</p>
            </div>

            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-text me-2"></i>
                        Contact Record Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Contact Information -->
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">Contact Information</h6>
                            
                            <div class="mb-2">
                                <strong>Call Number:</strong>
                                <div class="text-muted">@Model.CallNumber</div>
                            </div>

                            <div class="mb-2">
                                <strong>Contact Date:</strong>
                                <div class="text-muted">@Model.ContactDate.ToString("dddd, MMMM dd, yyyy 'at' HH:mm")</div>
                            </div>

                            <div class="mb-2">
                                <strong>Created By:</strong>
                                <div class="text-muted">@(Model.CreatedBy ?? "Unknown")</div>
                            </div>

                            <div class="mb-2">
                                <strong>Status:</strong>
                                <div class="text-muted">
                                    @Model.Status
                                </div>
                            </div>
                        </div>

                        <!-- Customer Information -->
                        <div class="col-md-6">
                            <h6 class="text-success mb-3">Customer Information</h6>
                            
                            <div class="mb-2">
                                <strong>Customer:</strong>
                                <div class="text-muted">@Model.Person?.FamilyName, @Model.Person?.Forename</div>
                            </div>

                            <div class="mb-2">
                                <strong>Email:</strong>
                                <div class="text-muted">@Model.CustomerEmail</div>
                            </div>

                            <div class="mb-2">
                                <strong>Phone:</strong>
                                <div class="text-muted">@Model.CustomerPhone</div>
                            </div>
                        </div>
                    </div>

                    <!-- Reason for Contact -->
                    <div class="mt-3 pt-3 border-top">
                        <h6 class="text-warning mb-2">Reason for Contact</h6>
                        <div class="p-3 bg-light rounded">
                            <em>"@Model.ReasonForContact"</em>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <div>
                    <a asp-action="Index" class="btn btn-secondary me-2">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to Customer Calls
                    </a>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                        <i class="bi bi-eye me-2"></i>
                        View Details
                    </a>
                </div>
                <div>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger" 
                                onclick="return confirm('Are you absolutely sure you want to delete this contact record? This action cannot be undone.')">
                            <i class="bi bi-trash me-2"></i>
                            Yes, Delete Contact
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
