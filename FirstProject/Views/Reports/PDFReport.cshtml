@model FirstProject.Models.ViewModels.ReportDataViewModel
@using FirstProject.Models

@{
    ViewData["Title"] = "PDF Report";
    Layout = null; // No layout for clean PDF generation
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Customer Call Report</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            font-size: 12px; 
            margin: 20px; 
            color: #000;
            background: white;
        }
        
        .header { 
            text-align: center; 
            margin-bottom: 30px; 
            border-bottom: 2px solid #000; 
            padding-bottom: 15px; 
        }
        
        .company-name { 
            font-size: 20px; 
            font-weight: bold; 
            margin-bottom: 5px; 
        }
        
        .report-title { 
            font-size: 16px; 
            color: #666; 
        }
        
        .report-date { 
            font-size: 11px; 
            color: #888; 
        }
        
        .filters { 
            background: #f5f5f5; 
            padding: 15px; 
            margin: 20px 0; 
            border-radius: 5px; 
            border: 1px solid #ddd;
        }
        
        .filters h4 { 
            margin: 0 0 10px 0; 
            font-size: 14px; 
        }
        
        .filter-item { 
            display: inline-block; 
            margin-right: 20px; 
            font-size: 11px; 
            margin-bottom: 5px;
        }
        
        .summary-stats {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
            padding: 15px;
            background: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-number {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }
        
        .stat-label {
            font-size: 10px;
            color: #666;
            margin-top: 2px;
        }
        
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 20px; 
        }
        
        th, td { 
            border: 1px solid #ddd; 
            padding: 8px; 
            text-align: left; 
            vertical-align: top;
        }
        
        th { 
            background-color: #f8f9fa; 
            font-weight: bold; 
            font-size: 11px; 
        }
        
        td { 
            font-size: 10px; 
        }
        
        .status-open { 
            background-color: #d4edda; 
            color: #155724;
            font-weight: bold;
        }
        
        .status-pending { 
            background-color: #fff3cd; 
            color: #856404;
            font-weight: bold;
        }
        
        .status-closed { 
            background-color: #f8d7da; 
            color: #721c24;
            font-weight: bold;
        }
        
        .footer { 
            margin-top: 30px;
            text-align: center;
            font-size: 10px; 
            color: #666; 
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
        
        /* Print-specific styles */
        @@media print {
            body {
                margin: 0;
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
            }
            
            .filters, .summary-stats {
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
            }
            
            table {
                page-break-inside: avoid;
            }
            
            tr {
                page-break-inside: avoid;
            }
            
            .header {
                page-break-after: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-name">Customer Call Management System</div>
        <div class="report-title">Customer Call Report</div>
        <div class="report-date">Generated on @Model.GeneratedDate.ToString("dddd, MMMM dd, yyyy 'at' HH:mm")</div>
    </div>
    
    <div class="filters">
        <h4>Report Filters Applied:</h4>
        <div class="filter-item"><strong>Date Range:</strong> @(Model.Filters.StartDate?.ToString("MM/dd/yyyy") ?? "All") - @(Model.Filters.EndDate?.ToString("MM/dd/yyyy") ?? "All")</div>
        <div class="filter-item"><strong>Status:</strong> @(Model.Filters.SelectedStatus?.ToString() ?? "All")</div>
        <div class="filter-item"><strong>Created By:</strong> @(Model.Filters.CreatedBy ?? "All")</div>
        <div class="filter-item"><strong>Total Records:</strong> @Model.TotalRecords</div>
    </div>
    
    <div class="summary-stats">
        <div class="stat-item">
            <div class="stat-number">@Model.TotalRecords</div>
            <div class="stat-label">Total Calls</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@Model.OpenCallsInResults</div>
            <div class="stat-label">Open Calls</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@Model.PendingCallsInResults</div>
            <div class="stat-label">Pending Calls</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@Model.ClosedCallsInResults</div>
            <div class="stat-label">Closed Calls</div>
        </div>
    </div>
    
    @if (Model.CustomerContacts.Any())
    {
        <table>
            <thead>
                <tr>
                    <th style="width: 10%;">Call Number</th>
                    <th style="width: 15%;">Customer</th>
                    <th style="width: 8%;">Date</th>
                    <th style="width: 15%;">Email</th>
                    <th style="width: 10%;">Phone</th>
                    <th style="width: 8%;">Status</th>
                    <th style="width: 25%;">Reason for Contact</th>
                    <th style="width: 9%;">Created By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var call in Model.CustomerContacts)
                {
                    var statusClass = call.Status switch
                    {
                        ContactStatus.Open => "status-open",
                        ContactStatus.Pending => "status-pending",
                        ContactStatus.Closed => "status-closed",
                        _ => ""
                    };

                    // Clean HTML from reason
                    string cleanReason = System.Text.RegularExpressions.Regex.Replace(call.ReasonForContact, "<.*?>", string.Empty);
                    if (cleanReason.Length > 150)
                        cleanReason = cleanReason.Substring(0, 150) + "...";

                    <tr>
                        <td>@call.CallNumber</td>
                        <td>@call.Person?.Forename @call.Person?.FamilyName</td>
                        <td>@call.ContactDate.ToString("MM/dd/yyyy")</td>
                        <td>@call.CustomerEmail</td>
                        <td>@call.CustomerPhone</td>
                        <td class="@statusClass">@call.Status</td>
                        <td>@cleanReason</td>
                        <td>@(call.CreatedBy ?? "Unknown")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 40px; color: #666;">
            No records found matching the applied filters.
        </div>
    }
    
    <div class="footer">
        <strong>Customer Call Management System</strong> - Confidential Report<br>
        @if (Model.EarliestCall.HasValue && Model.LatestCall.HasValue)
        {
            <span>Date Range: @Model.EarliestCall.Value.ToString("MM/dd/yyyy") to @Model.LatestCall.Value.ToString("MM/dd/yyyy")</span>
        }
    </div>
    
    <script>
        // Auto-trigger print dialog when page loads (for PDF generation)
        window.onload = function() {
            // Small delay to ensure page is fully rendered
            setTimeout(function() {
                window.print();
            }, 1000);
        };
    </script>
</body>
</html>
