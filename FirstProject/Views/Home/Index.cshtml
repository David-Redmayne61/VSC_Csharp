@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-4 text-primary">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </h1>
                <div class="text-muted">
                    Welcome back, @(User.Identity?.Name ?? "User")
                </div>
            </div>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-5">
        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-people-fill"></i> Total People
                        </h5>
                        <h2 class="mb-0">@ViewBag.TotalPeople</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-people-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-person-check-fill"></i> Total Users
                        </h5>
                        <h2 class="mb-0">@ViewBag.TotalUsers</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-person-check-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-clock-history"></i> Recent Entries
                        </h5>
                        <h2 class="mb-0">@(ViewBag.RecentlyAdded != null ? ((List<FirstProject.Models.Person>)ViewBag.RecentlyAdded).Count : 0)</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-clock-history" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-calendar-date"></i> Today
                        </h5>
                        <p class="mb-1 small">@DateTime.Now.ToString("MMM dd, yyyy")</p>
                        <p class="mb-0 small">@DateTime.Now.ToString("HH:mm:ss")</p>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-calendar-date" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Contact Statistics -->
    <div class="row mb-4">
        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-telephone-fill"></i> Total Customer Calls
                        </h5>
                        <h2 class="mb-0">@ViewBag.TotalContacts</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-telephone-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-danger text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-circle-fill"></i> Open Customer Calls
                        </h5>
                        <h2 class="mb-0">@ViewBag.OpenContacts</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-circle-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-dark text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-exclamation-triangle-fill"></i> Aged Open Calls
                        </h5>
                        <p class="mb-1 small">Over 7 days old</p>
                        <h2 class="mb-0">@ViewBag.AgedOpenContacts</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-clock-fill"></i> Pending Customer Calls
                        </h5>
                        <h2 class="mb-0">@ViewBag.PendingContacts</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-clock-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            <i class="bi bi-check-circle-fill"></i> Closed Customer Calls
                        </h5>
                        <h2 class="mb-0">@ViewBag.ClosedContacts</h2>
                    </div>
                    <div class="ms-3">
                        <i class="bi bi-check-circle-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="h4 mb-3">
                <i class="bi bi-lightning-charge"></i> Quick Actions
            </h2>
        </div>
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-search text-primary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Search People</h5>
                    <p class="card-text">Find people using advanced search with wildcards</p>
                    <a href="@Url.Action("Search")" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search Now
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-success h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-plus text-success" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Add Person</h5>
                    <p class="card-text">Add a new person to the database</p>
                    <a href="@Url.Action("AddPerson")" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Add Person
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-info h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list-ul text-info" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">View All</h5>
                    <p class="card-text">Browse and manage all people in the database</p>
                    <a href="@Url.Action("ViewPeople")" class="btn btn-info">
                        <i class="bi bi-list-ul"></i> View All
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-warning h-100">
                <div class="card-body text-center">
                    <i class="bi bi-upload text-warning" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Import Data</h5>
                    <p class="card-text">Import people from CSV or Excel files</p>
                    <a href="@Url.Action("Import")" class="btn btn-warning">
                        <i class="bi bi-upload"></i> Import
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Second row for Export -->
    <div class="row mb-5">
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-danger h-100">
                <div class="card-body text-center">
                    <i class="bi bi-telephone-plus text-danger" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Record Customer Call</h5>
                    <p class="card-text">Record a new customer service call or contact</p>
                    <a href="@Url.Action("Create", "Contact")" class="btn btn-danger">
                        <i class="bi bi-plus-circle"></i> New Call
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-info h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list-ul text-info" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">View all Customer Calls</h5>
                    <p class="card-text">Browse and manage all customer service calls</p>
                    <a href="@Url.Action("Index", "Contact")" class="btn btn-info">
                        <i class="bi bi-eye"></i> View List
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-secondary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-download text-secondary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Export Data</h5>
                    <p class="card-text">Export data to Excel, PDF, or CSV formats</p>
                    <a href="@Url.Action("Export")" class="btn btn-secondary">
                        <i class="bi bi-download"></i> Export
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up text-primary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Reports</h5>
                    <p class="card-text">Generate customer call reports and analytics</p>
                    <a href="@Url.Action("Index", "Reports")" class="btn btn-primary">
                        <i class="bi bi-file-earmark-text"></i> View Reports
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recently Added -->
    @if (ViewBag.RecentlyAdded != null && ((List<FirstProject.Models.Person>)ViewBag.RecentlyAdded).Any())
    {
        <div class="row">
            <div class="col-12">
                <h2 class="h4 mb-3">
                    <i class="bi bi-clock-history"></i> Recently Added
                </h2>
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>Year of Birth</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var person in (List<FirstProject.Models.Person>)ViewBag.RecentlyAdded)
                                    {
                                        <tr>
                                            <td>@person.Id</td>
                                            <td>@person.Forename @person.FamilyName</td>
                                            <td>@person.Gender</td>
                                            <td>@person.YearOfBirth</td>
                                            <td>
                                                <a href="@Url.Action("Edit", new { id = person.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = person.Id })" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <a href="@Url.Action("ViewPeople")" class="btn btn-link">
                                View all people <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
